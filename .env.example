# Copy to .env and fill in. Never commit .env. On Render, set these in the dashboard.

# --- App ---
# development | production
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
# Long random string, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Separate random string used to hash IP addresses (KVKK: raw IPs are never stored)
IP_HASH_SALT=
# Comma-separated; only needed for the Vite dev server
ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Local default is SQLite. On Render use the Postgres "Internal Database URL".
DATABASE_URL=sqlite:///./data/app.db

# --- Storage ---
CACHE_DIR=./data/cache
CACHE_MAX_GB=5
EVENT_RETENTION_DAYS=90

# --- Admin ---
# The account with this e-mail gets the admin role after verifying its code.
ADMIN_EMAIL=

# --- E-mail (EmailJS REST API, server side, uses the private key as accessToken) ---
# Template variables: {{to_email}} (put it in the template's "To Email" field), {{code}}, {{valid_minutes}}, {{site_url}}.
# EmailJS dashboard: Account -> Security -> enable "Allow EmailJS API for non-browser applications".
# All four empty: in development the code is written to the server log only; in production sign-in is off.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- External APIs ---
# Wikimedia asks for a descriptive User-Agent with a contact URL (project repo, not a personal e-mail)
WIKIMEDIA_USER_AGENT=SPHEREx-Gokyuzu-Izleyici/0.1 (+https://github.com/OWNER/REPO)
